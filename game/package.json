{
  "name": "kabegakoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "カベガコイ(仮称)— 壁囲碁アレンジ 対戦ボードゲーム",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "electron:dev": "vite build && electron electron/main.cjs",
    "electron:build": "vite build && electron-builder --win nsis",
    "cap:sync": "vite build && npx cap sync"
  },
  "build": {
    "appId": "com.example.kabegakoi",
    "productName": "カベガコイ",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "three": "^0.170.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
